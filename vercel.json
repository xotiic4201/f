{
  "rewrites": [
  "builds": [
    {
      "source": "/(.*)",
      "destination": "/main.html"
      "src": "api/index.py",
      "use": "@vercel/python"
    }
  ],
  "headers": [
  "routes": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        }
      ]
      "src": "/(.*)",
      "dest": "api/index.py"
    }
  ]
}



